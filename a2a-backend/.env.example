# Required
DATABASE_URL=postgresql://a2a:changeme@localhost:5432/a2a
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional — defaults shown
ALLOWED_ORIGINS=http://localhost:3000
VPC_MODE=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
APPROVAL_LINK_SECRET=change-me-in-production

# Optional — Supabase admin (for email lookup in approval notifications)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Resend (for approval email notifications)
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
