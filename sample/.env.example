# Copy this file to .env and fill in your values.
#
# How to get your API key:
#   1. Go to https://a2a.midlantics.com/dashboard/settings
#   2. Click "Create API key", give it a name (e.g. "local-test")
#   3. Copy the key that starts with  a2a_sk_...
#      It is shown ONCE — save it here immediately.

A2A_API_KEY=a2a_sk_...
A2A_API_URL=https://a2a-api.midlantics.com

# LLM provider keys — add whichever you use (all optional)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
GOOGLE_API_KEY=...              # for Gemini
