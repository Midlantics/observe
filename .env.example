# Cloud (Railway + Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_ORIGINS=https://a2a.midlantics.com
# VPC / self-hosted: set to "true" to enable /docs and skip Supabase JWT
VPC_MODE=false
APP_URL=https://a2a.midlantics.com
API_URL=https://a2a-api.midlantics.com

# Email notifications (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Midlantics A2A <notifications@a2a.midlantics.com>

# Approval magic links — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_LINK_SECRET=change-me-in-production

